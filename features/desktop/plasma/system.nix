{ config, pkgs, ... }:

{
  # Enable the KDE Plasma Desktop Environment.
  services.displayManager.sddm.enable = true;
  services.desktopManager.plasma6.enable = true;

  # KDE Connect — phone ↔ desktop integration
  programs.kdeconnect.enable = true;  # installs package + opens firewall ports 1714-1764

  # Partition Manager — needs system-level install for polkit action registration
  environment.systemPackages = with pkgs; [
    kdePackages.partitionmanager

    # WORKAROUND: Digital Clock calendar ↔ Merkuro/Akonadi integration:
    #   - kdepim-addons provides the "PIM Events Plugin" (pimevents.so) that the
    #     clock's calendar popup reads from. Not pulled in by the plasma6 module
    #     by default because it drags in a chunk of Plasma.
    #   - akonadi-calendar is required for the events to actually render in the
    #     widget after recent Plasma/Akonadi updates (nixpkgs#344025).
    # After rebuild: right-click clock → Configure → Calendar → enable
    # "PIM Events Plugin", then enable the Merkuro calendar in the sidebar.
    kdePackages.kdepim-addons
    kdePackages.akonadi-calendar
  ];

  # WORKAROUND: NixOS-specific: expose Akonadi resource .desktop files so Merkuro
  # can register calendar sources (CalDAV/local). Without this Merkuro shows no
  # calendar sources to add (nixpkgs#344025).
  environment.pathsToLink = [ "/share/akonadi" ];

  # WORKAROUND: Baloo file extractor crash fix (regressed with the 2026-10-19
  # update: Plasma 6.7.5 -> 6.8.0, Qt 6.11.1 -> 6.11.2; baloo/KF6 6.30.0).
  #
  # Plasma 6.8 is the first Wayland-only release (X11 session support dropped,
  # per KDE's "Plasma/Wayland Known Significant Issues"). After the bump the
  # kde-baloo user service inherits WAYLAND_DISPLAY / XDG_SESSION_TYPE=wayland
  # but cannot reach the compositor socket from the background.slice sandbox.
  #
  # baloo_file_extractor builds a QGuiApplication, so it needs a Qt platform
  # (QPA) plugin:
  #   - "wayland" fails first: "Failed to create wl_display (No such file ...)"
  #   - "xcb" fallback also fails: missing libxcb-cursor in its closure
  # With no platform, Qt calls qFatal() -> abort(), i.e. the "Baloo File
  # Extractor closed unexpectedly" crash that fires every time a new/changed
  # file is queued for indexing. (Also reported on Plasma 6.8 upstream:
  # discuss.kde.org "Plasma Desktop borked after 6.8 Update".)
  #
  # The extractor only reads file metadata and never needs a real display, so
  # force the headless "offscreen" QPA plugin for the service.
  #
  # Upstream is unlikely to make this obsolete soon: baloo intentionally keeps
  # the extractor as a QGuiApplication (MR !192 switched it to a headless
  # QCoreApplication, but MR !200 reverted that because some image/thumbnail
  # extractors need the GUI stack). "offscreen" is the canonical headless QPA
  # plugin and is additive, so this will not collide with a future update:
  #   - if nixpkgs/KDE later set the same var on the unit -> redundant, harmless
  #   - if the extractor ever becomes a QCoreApplication -> the var is ignored
  # REMOVE this override once baloo_file_extractor no longer crashes without it
  # (test: comment out, rebuild, modify a file, watch `journalctl --user -u
  # kde-baloo.service -f`).
  #
  # overrideStrategy = "asDropin" is REQUIRED here: kde-baloo.service is shipped
  # by the baloo package, not generated by NixOS. The default strategy would
  # emit a full replacement unit containing only [Service]/Environment=, with no
  # ExecStart, so systemd rejects it as a "bad unit file setting". "asDropin"
  # makes NixOS write a drop-in that merges with the package unit instead.
  systemd.user.services.kde-baloo = {
    overrideStrategy = "asDropin";
    environment.QT_QPA_PLATFORM = "offscreen";
  };
}
